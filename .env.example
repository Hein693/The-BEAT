# ===================================================
# The BEAT - Environment Variables Configuration
# ===================================================

# Server Port
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=the_beat_db
DB_PORT=3306

# API Configuration (Deezer & iTunes public endpoints)
DEEZER_API_BASE=https://api.deezer.com
ITUNES_API_BASE=https://itunes.apple.com

# Optional API Keys (if using services like Last.fm or Spotify API in future)
LASTFM_API_KEY=
